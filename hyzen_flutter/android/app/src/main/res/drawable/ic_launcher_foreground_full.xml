<?xml version="1.0" encoding="utf-8"?>
<!-- Enlarge the approved artwork without changing the panda identity.
     Android's adaptive mask clips the white perimeter, not a replacement logo. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="-12dp"
    android:insetTop="-12dp"
    android:insetRight="-12dp"
    android:insetBottom="-12dp">
    <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="fill" />
</inset>
